<?xml version="1.0" ?>

<!-- This xacro file contains visual elements only -->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="bobble_chassis">

	<link name="bobble_chassis_link">
  		<inertial>
	  		<origin xyz="0.0 0.0 0.180" rpy="0.0 0.0 0.0"/>
  	  		<mass value="2.043"/>
	  		<inertia ixx="0.0085" ixy="0.0" ixz="0.0" iyy="0.0088" iyz="0.0" izz="0.0047"/>
		</inertial>
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
  				<mesh filename="package://bobble_description/meshes/chassis_grey.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
		<collision>
            <origin xyz="0.0 0.0 0.10263" rpy="0.0 0.0 0.0"/>
            <geometry>
              <box size="0.122 0.1129 0.19226" />
            </geometry>
			
		</collision>
	</link>

	<gazebo reference="bobble_chassis_link">
		<selfCollide>false</selfCollide>
        <material>
            Gazebo/Gray
        </material>
	</gazebo>

	</xacro:macro>

</robot>
