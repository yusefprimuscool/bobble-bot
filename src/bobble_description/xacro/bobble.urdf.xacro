<?xml version="1.0"?>

<robot name="bobblebot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find bobble_description)/xacro/bobble_chassis.urdf.xacro" />
  <xacro:include filename="$(find bobble_description)/xacro/bobble_chassis2.urdf.xacro" />
  <xacro:include filename="$(find bobble_description)/xacro/bobble_battery.urdf.xacro" />
  <xacro:include filename="$(find bobble_description)/xacro/bobble_realsense.urdf.xacro" />
  <xacro:include filename="$(find bobble_description)/xacro/bobble_electronics.urdf.xacro" />
  <xacro:include filename="$(find bobble_description)/xacro/camera.urdf.xacro" />
  <xacro:include filename="$(find bobble_description)/xacro/bno055_imu.urdf.xacro" />
  <xacro:include filename="$(find bobble_description)/xacro/left_wheel.urdf.xacro" />
  <xacro:include filename="$(find bobble_description)/xacro/right_wheel.urdf.xacro" />

  <xacro:bobble_chassis>
  </xacro:bobble_chassis>
  <xacro:bobble_chassis2 parent="bobble_chassis_link">
  </xacro:bobble_chassis2>
  <xacro:bobble_battery parent="bobble_chassis_link">
  </xacro:bobble_battery>
  <xacro:bobble_realsense parent="bobble_chassis_link">
  </xacro:bobble_realsense>
  <xacro:bobble_electronics parent="bobble_chassis_link">
  </xacro:bobble_electronics>
  <xacro:bno055_imu parent="bobble_chassis_link">
  </xacro:bno055_imu>
  <!--<xacro:camera_macro parent="bobble_chassis_link">
  </xacro:camera_macro>-->
  <xacro:left_wheel parent="bobble_chassis_link">
  </xacro:left_wheel>
  <xacro:right_wheel parent="bobble_chassis_link">
  </xacro:right_wheel>

  <gazebo>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  </gazebo>
  
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find bobble_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>



  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_hinge">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_hinge">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>



  <gazebo reference="bno055_imu_link">
    <sensor name="bno055_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>imu</topic>
    </sensor>
  </gazebo>

</robot>
